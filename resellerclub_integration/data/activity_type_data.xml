<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Activity Types for ResellerClub Service Management
            These activity types help organize and track service-related tasks
        -->

        <!-- Domain Activities -->
        <record id="activity_type_domain_expiry" model="mail.activity.type">
            <field name="name">Domain Expiry Reminder</field>
            <field name="summary">Domain expiring soon - renewal required</field>
            <field name="icon">fa-globe</field>
            <field name="delay_count">30</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
            <field name="res_model">resellerclub.domain</field>
            <field name="category">reminder</field>
            <field name="decoration_type">warning</field>
        </record>

        <record id="activity_type_domain_transfer" model="mail.activity.type">
            <field name="name">Domain Transfer Follow-up</field>
            <field name="summary">Follow up on domain transfer status</field>
            <field name="icon">fa-exchange</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="res_model">resellerclub.domain</field>
            <field name="category">reminder</field>
        </record>

        <record id="activity_type_dns_verification" model="mail.activity.type">
            <field name="name">DNS Verification</field>
            <field name="summary">Verify DNS propagation</field>
            <field name="icon">fa-cogs</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
            <field name="res_model">resellerclub.domain</field>
            <field name="category">reminder</field>
        </record>

        <!-- Hosting Activities -->
        <record id="activity_type_hosting_expiry" model="mail.activity.type">
            <field name="name">Hosting Expiry Reminder</field>
            <field name="summary">Hosting plan expiring soon - renewal required</field>
            <field name="icon">fa-server</field>
            <field name="delay_count">30</field>
            <field name="delay_unit">days</field>
            <field name="res_model">resellerclub.hosting</field>
            <field name="category">reminder</field>
            <field name="decoration_type">warning</field>
        </record>

        <record id="activity_type_hosting_setup" model="mail.activity.type">
            <field name="name">Hosting Setup Verification</field>
            <field name="summary">Verify hosting account is properly configured</field>
            <field name="icon">fa-check-circle</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
            <field name="res_model">resellerclub.hosting</field>
            <field name="category">reminder</field>
        </record>

        <!-- SSL Activities -->
        <record id="activity_type_ssl_expiry" model="mail.activity.type">
            <field name="name">SSL Certificate Expiry</field>
            <field name="summary">SSL certificate expiring - renewal required</field>
            <field name="icon">fa-lock</field>
            <field name="delay_count">30</field>
            <field name="delay_unit">days</field>
            <field name="res_model">resellerclub.ssl</field>
            <field name="category">reminder</field>
            <field name="decoration_type">danger</field>
        </record>

        <record id="activity_type_ssl_validation" model="mail.activity.type">
            <field name="name">SSL Validation Pending</field>
            <field name="summary">Complete SSL certificate domain validation</field>
            <field name="icon">fa-shield</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
            <field name="res_model">resellerclub.ssl</field>
            <field name="category">reminder</field>
            <field name="decoration_type">warning</field>
        </record>

        <!-- Customer Activities -->
        <record id="activity_type_customer_verification" model="mail.activity.type">
            <field name="name">Customer Verification</field>
            <field name="summary">Verify customer account in ResellerClub</field>
            <field name="icon">fa-user-check</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
            <field name="res_model">resellerclub.customer</field>
            <field name="category">reminder</field>
        </record>

        <!-- Subscription Renewal Activities -->
        <record id="activity_type_subscription_renewal" model="mail.activity.type">
            <field name="name">Subscription Renewal</field>
            <field name="summary">Process subscription renewal in ResellerClub</field>
            <field name="icon">fa-refresh</field>
            <field name="delay_count">7</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">previous_activity</field>
            <field name="res_model">sale.order</field>
            <field name="category">reminder</field>
        </record>
    </data>
</odoo>
