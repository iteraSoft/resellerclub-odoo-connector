    <template id="checkout_rc_info" name="Domain Configuration">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="py-5">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <h2 class="mb-4">Domain Configuration</h2>
                                <p class="text-muted">Configure nameservers for your domains</p>

                                <form action="/shop/checkout/rc_info/submit" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <t t-foreach="domain_lines" t-as="item">
                                        <div class="card mb-4">
                                            <div class="card-header">
                                                <strong t-esc="item['domain']"/>
                                            </div>
                                            <div class="card-body">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Nameserver 1</label>
                                                        <input type="text" class="form-control"
                                                               t-att-name="'ns1_' + str(item['line'].id)"
                                                               t-att-value="default_nameservers[0] if default_nameservers else ''"
                                                               required="required"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Nameserver 2</label>
                                                        <input type="text" class="form-control"
                                                               t-att-name="'ns2_' + str(item['line'].id)"
                                                               t-att-value="default_nameservers[1] if len(default_nameservers) > 1 else ''"
                                                               required="required"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Nameserver 3 (Optional)</label>
                                                        <input type="text" class="form-control"
                                                               t-att-name="'ns3_' + str(item['line'].id)"
                                                               t-att-value="default_nameservers[2] if len(default_nameservers) > 2 else ''"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Nameserver 4 (Optional)</label>
                                                        <input type="text" class="form-control"
                                                               t-att-name="'ns4_' + str(item['line'].id)"
                                                               t-att-value="default_nameservers[3] if len(default_nameservers) > 3 else ''"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>

                                    <div class="d-flex justify-content-between">
                                        <a href="/shop/cart" class="btn btn-secondary">
                                            <i class="fa fa-arrow-left me-2"></i>Back to Cart
                                        </a>
                                        <button type="submit" class="btn btn-primary">
                                            Continue to Checkout<i class="fa fa-arrow-right ms-2"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
