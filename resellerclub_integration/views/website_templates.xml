                            <t t-set="products" t-value="type_products[1]"/>

                            <div class="mb-5">
                                <h3 class="mb-4">
                                    <t t-esc="hosting_types.get(type_code, type_code)"/>
                                </h3>
                                <div class="row">
                                    <t t-foreach="products" t-as="product">
