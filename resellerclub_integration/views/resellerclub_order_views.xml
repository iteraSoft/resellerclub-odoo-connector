<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RC Order Tree View -->
    <record id="resellerclub_order_view_list" model="ir.ui.view">
        <field name="name">resellerclub.order.list</field>
        <field name="model">resellerclub.order</field>
        <field name="arch" type="xml">
            <list string="ResellerClub Orders"
                  decoration-warning="status == 'pending'"
                  decoration-danger="status in ['failed', 'cancelled']"
                  decoration-muted="status == 'expired'">
                <field name="resellerclub_order_id"/>
                <field name="order_type" widget="badge"/>
                <field name="product_name"/>
                <field name="partner_id"/>
                <field name="status" widget="badge"
                       decoration-success="status in ['active', 'completed']"
                       decoration-danger="status in ['failed', 'cancelled']"
                       decoration-warning="status == 'pending'"
                       decoration-info="status == 'processing'"/>
                <field name="order_date"/>
                <field name="expiration_date"/>
                <field name="amount" optional="show"/>
                <field name="currency_code" optional="hide"/>
                <field name="sale_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- RC Order Form View -->
    <record id="resellerclub_order_view_form" model="ir.ui.view">
        <field name="name">resellerclub.order.form</field>
        <field name="model">resellerclub.order</field>
        <field name="arch" type="xml">
            <form string="ResellerClub Order">
                <header>
                    <button name="action_sync_from_resellerclub" type="object"
                            string="Sync" class="btn-secondary"/>
                    <button name="action_view_linked_record" type="object"
                            string="View Record" class="btn-secondary"
                            invisible="not domain_id and not hosting_id and not ssl_id"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,processing,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="resellerclub_order_id"/>
                        <h1>
                            <field name="resellerclub_order_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Order Details">
                            <field name="order_type"/>
                            <field name="product_key"/>
                            <field name="product_name"/>
                            <field name="customer_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Dates &amp; Billing">
                            <field name="order_date"/>
                            <field name="creation_date"/>
                            <field name="expiration_date"/>
                            <field name="amount"/>
                            <field name="currency_code"/>
                            <field name="transaction_id"/>
                        </group>
                    </group>
                    <group string="Linked Records">
                        <group>
                            <field name="domain_id"/>
                            <field name="hosting_id"/>
                            <field name="ssl_id"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id"/>
                        </group>
                    </group>
                    <group string="Sync Status">
                        <group>
                            <field name="sync_status" widget="badge"/>
                            <field name="last_sync_date"/>
                        </group>
                        <group>
                            <field name="sync_error" invisible="not sync_error"/>
                        </group>
                    </group>
                    <notebook invisible="not raw_response">
                        <page string="Raw Response" name="raw">
                            <field name="raw_response" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- RC Order Search View -->
    <record id="resellerclub_order_view_search" model="ir.ui.view">
        <field name="name">resellerclub.order.search</field>
        <field name="model">resellerclub.order</field>
        <field name="arch" type="xml">
            <search string="Search Orders">
                <field name="resellerclub_order_id"/>
                <field name="product_name"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="filter_pending" string="Pending" domain="[('status', 'in', ['pending', 'processing'])]"/>
                <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter name="filter_domain" string="Domains" domain="[('order_type', 'like', 'domain')]"/>
                <filter name="filter_hosting" string="Hosting" domain="[('order_type', '=', 'hosting')]"/>
                <filter name="filter_ssl" string="SSL" domain="[('order_type', '=', 'ssl')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Order Type" context="{'group_by': 'order_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Order Date" context="{'group_by': 'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- RC Order Action -->
    <record id="action_resellerclub_order" model="ir.actions.act_window">
        <field name="name">RC Orders</field>
        <field name="res_model">resellerclub.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="resellerclub_order_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No ResellerClub orders yet
            </p>
            <p>
                Orders will appear here when you register domains, order hosting, or purchase SSL certificates.
            </p>
        </field>
    </record>

    <!-- API Log Views -->
    <record id="resellerclub_api_log_view_list" model="ir.ui.view">
        <field name="name">resellerclub.api.log.list</field>
        <field name="model">resellerclub.api.log</field>
        <field name="arch" type="xml">
            <list string="API Logs" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="duration"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="resellerclub_api_log_view_form" model="ir.ui.view">
        <field name="name">resellerclub.api.log.form</field>
        <field name="model">resellerclub.api.log</field>
        <field name="arch" type="xml">
            <form string="API Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_params"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_data"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resellerclub_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">resellerclub.api.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Transaction Views -->
    <record id="resellerclub_transaction_view_list" model="ir.ui.view">
        <field name="name">resellerclub.transaction.list</field>
        <field name="model">resellerclub.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions" create="false">
                <field name="transaction_date"/>
                <field name="transaction_id"/>
                <field name="transaction_type" widget="badge"/>
                <field name="description"/>
                <field name="amount" decoration-danger="amount &lt; 0" decoration-success="amount &gt; 0"/>
                <field name="balance_after"/>
                <field name="currency_code"/>
            </list>
        </field>
    </record>

    <record id="action_resellerclub_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">resellerclub.transaction</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
