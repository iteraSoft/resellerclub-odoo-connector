<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Domain Tree View -->
    <record id="resellerclub_domain_view_list" model="ir.ui.view">
        <field name="name">resellerclub.domain.list</field>
        <field name="model">resellerclub.domain</field>
        <field name="arch" type="xml">
            <list string="Domains"
                  decoration-danger="expiry_status == 'expired'"
                  decoration-warning="expiry_status in ['warning', 'critical']"
                  multi_edit="1">
                <field name="domain_name"/>
                <field name="tld"/>
                <field name="partner_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-danger="status in ['expired', 'deleted', 'suspended']"
                       decoration-info="status == 'pending'"
                       decoration-warning="status == 'pending_transfer'"/>
                <field name="registration_date"/>
                <field name="expiration_date"/>
                <field name="days_until_expiry"/>
                <field name="auto_renew" widget="boolean_toggle"/>
                <field name="privacy_protection" widget="boolean_toggle"/>
                <field name="theft_protection" widget="boolean_toggle"/>
                <field name="resellerclub_order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Domain Kanban View -->
    <record id="resellerclub_domain_view_kanban" model="ir.ui.view">
        <field name="name">resellerclub.domain.kanban</field>
        <field name="model">resellerclub.domain</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="domain_name"/>
                <field name="status"/>
                <field name="expiration_date"/>
                <field name="days_until_expiry"/>
                <field name="expiry_status"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong class="o_kanban_record_title">
                                <field name="domain_name"/>
                            </strong>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'active'"
                                   decoration-danger="status in ['expired', 'deleted']"/>
                        </div>
                        <div class="text-muted small">
                            <span t-if="record.expiration_date.value">
                                Expires: <field name="expiration_date"/>
                            </span>
                        </div>
                        <div class="mt-2">
                            <span t-attf-class="badge #{record.expiry_status.raw_value == 'ok' ? 'text-bg-success' : record.expiry_status.raw_value == 'warning' ? 'text-bg-warning' : 'text-bg-danger'}">
                                <field name="days_until_expiry"/> days
                            </span>
                        </div>
                        <footer class="pt-2 d-flex justify-content-between">
                            <field name="partner_id" widget="many2one_avatar"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Domain Form View -->
    <record id="resellerclub_domain_view_form" model="ir.ui.view">
        <field name="name">resellerclub.domain.form</field>
        <field name="model">resellerclub.domain</field>
        <field name="arch" type="xml">
            <form string="Domain">
                <header>
                    <button name="action_register_domain" type="object"
                            string="Register Domain" class="btn-primary"
                            invisible="resellerclub_order_id"/>
                    <button name="action_renew_domain" type="object"
                            string="Renew" class="btn-primary"
                            invisible="status != 'active'"/>
                    <button name="action_sync_from_resellerclub" type="object"
                            string="Sync" class="btn-secondary"
                            invisible="not resellerclub_order_id"/>
                    <button name="action_get_auth_code" type="object"
                            string="Get Auth Code" class="btn-secondary"
                            invisible="status != 'active'"/>
                    <button name="action_toggle_theft_protection" type="object"
                            string="Toggle Lock" class="btn-secondary"
                            invisible="status != 'active'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_manage_dns" type="object" class="oe_stat_button" icon="fa-cogs"
                                invisible="status != 'active'">
                            <span>DNS Records</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="expiry_status != 'expired'"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning"
                            invisible="expiry_status not in ['warning', 'critical']"/>
                    <div class="oe_title">
                        <h1>
                            <field name="domain_name" placeholder="example.com"
                                   readonly="resellerclub_order_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Registration">
                            <field name="customer_id"/>
                            <field name="partner_id"/>
                            <field name="years" invisible="resellerclub_order_id"/>
                            <field name="registration_date"/>
                            <field name="expiration_date"/>
                            <field name="days_until_expiry"/>
                        </group>
                        <group string="Settings">
                            <field name="auto_renew"/>
                            <field name="privacy_protection"/>
                            <field name="theft_protection"/>
                            <field name="resellerclub_order_id" readonly="1"/>
                            <field name="auth_code" password="True" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nameservers" name="nameservers">
                            <group>
                                <group>
                                    <field name="ns1" placeholder="ns1.example.com"/>
                                    <field name="ns2" placeholder="ns2.example.com"/>
                                    <field name="ns3" placeholder="ns3.example.com"/>
                                </group>
                                <group>
                                    <field name="ns4" placeholder="ns4.example.com"/>
                                    <field name="ns5" placeholder="ns5.example.com"/>
                                </group>
                            </group>
                            <div class="mt-3" invisible="not resellerclub_order_id or status != 'active'">
                                <button name="action_modify_nameservers" type="object"
                                        string="Update Nameservers" class="btn-primary"/>
                            </div>
                        </page>
                        <page string="Contacts" name="contacts">
                            <group>
                                <group>
                                    <field name="registrant_contact_id"/>
                                    <field name="admin_contact_id"/>
                                </group>
                                <group>
                                    <field name="tech_contact_id"/>
                                    <field name="billing_contact_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="DNS Records" name="dns" invisible="status != 'active'">
                            <field name="dns_record_ids">
                                <list editable="bottom">
                                    <field name="record_type"/>
                                    <field name="host"/>
                                    <field name="value"/>
                                    <field name="ttl"/>
                                    <field name="priority" invisible="record_type not in ['MX', 'SRV']"/>
                                    <field name="is_synced" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                        <page string="Orders" name="orders">
                            <field name="order_line_ids" readonly="1">
                                <list>
                                    <field name="order_id"/>
                                    <field name="product_id"/>
                                    <field name="price_unit"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Domain Search View -->
    <record id="resellerclub_domain_view_search" model="ir.ui.view">
        <field name="name">resellerclub.domain.search</field>
        <field name="model">resellerclub.domain</field>
        <field name="arch" type="xml">
            <search string="Search Domains">
                <field name="domain_name"/>
                <field name="tld"/>
                <field name="partner_id"/>
                <field name="customer_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="filter_expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="filter_pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <separator/>
                <filter name="filter_expiring_30" string="Expiring in 30 days"
                        domain="[('days_until_expiry', '&lt;=', 30), ('days_until_expiry', '&gt;', 0)]"/>
                <filter name="filter_expiring_7" string="Expiring in 7 days"
                        domain="[('days_until_expiry', '&lt;=', 7), ('days_until_expiry', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_auto_renew" string="Auto Renew" domain="[('auto_renew', '=', True)]"/>
                <filter name="filter_privacy" string="Privacy Protection" domain="[('privacy_protection', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_tld" string="TLD" context="{'group_by': 'tld'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_expiry" string="Expiration Month" context="{'group_by': 'expiration_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Domain Calendar View -->
    <record id="resellerclub_domain_view_calendar" model="ir.ui.view">
        <field name="name">resellerclub.domain.calendar</field>
        <field name="model">resellerclub.domain</field>
        <field name="arch" type="xml">
            <calendar string="Domain Expirations" date_start="expiration_date" color="status" mode="month">
                <field name="domain_name"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- Domain Action -->
    <record id="action_resellerclub_domain" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">resellerclub.domain</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="search_view_id" ref="resellerclub_domain_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first domain
            </p>
            <p>
                Manage domain registrations, transfers, and renewals through ResellerClub.
            </p>
        </field>
    </record>

    <!-- Expiring Domains Action -->
    <record id="action_resellerclub_domain_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Domains</field>
        <field name="res_model">resellerclub.domain</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'active'), ('days_until_expiry', '&lt;=', 30)]</field>
        <field name="context">{'search_default_filter_expiring_30': 1}</field>
    </record>
</odoo>
