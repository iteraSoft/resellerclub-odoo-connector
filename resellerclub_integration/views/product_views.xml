<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form Inherit -->
    <record id="product_template_form_view_inherit_resellerclub" model="ir.ui.view">
        <field name="name">product.template.form.inherit.resellerclub</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="ResellerClub" name="resellerclub"
                      invisible="not is_resellerclub_product"
                      groups="resellerclub_integration.group_resellerclub_user">
                    <group>
                        <group string="Product Configuration">
                            <field name="is_resellerclub_product"/>
                            <field name="rc_product_type"/>
                            <field name="rc_plan_id"/>
                            <field name="rc_tld" invisible="rc_product_type != 'domain'"/>
                        </group>
                        <group string="Pricing">
                            <field name="rc_cost_price"/>
                            <field name="rc_last_sync"/>
                        </group>
                    </group>
                    <group invisible="rc_product_type != 'domain'">
                        <group string="Domain Options">
                            <field name="rc_min_years"/>
                            <field name="rc_max_years"/>
                            <field name="rc_supports_privacy"/>
                            <field name="rc_supports_transfer"/>
                        </group>
                    </group>
                    <div class="mt-3">
                        <button name="action_sync_from_resellerclub" type="object"
                                string="Sync Pricing from ResellerClub" class="btn-primary"
                                invisible="not is_resellerclub_product"/>
                    </div>
                </page>
            </xpath>
            <!-- Add indicator in the header -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-cloud"
                        invisible="not is_resellerclub_product"
                        name="action_sync_from_resellerclub" type="object">
                    <span>ResellerClub</span>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Product Template List Inherit -->
    <record id="product_template_list_view_inherit_resellerclub" model="ir.ui.view">
        <field name="name">product.template.list.inherit.resellerclub</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_resellerclub_product" column_invisible="1"/>
                <field name="rc_product_type" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ResellerClub Products Action -->
    <record id="action_resellerclub_products" model="ir.actions.act_window">
        <field name="name">ResellerClub Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_resellerclub_product', '=', True)]</field>
        <field name="context">{'default_is_resellerclub_product': True, 'default_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No ResellerClub products yet
            </p>
            <p>
                Go to Settings > ResellerClub to sync products from your ResellerClub account.
            </p>
        </field>
    </record>
</odoo>
