<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Tree View -->
    <record id="resellerclub_customer_view_list" model="ir.ui.view">
        <field name="name">resellerclub.customer.list</field>
        <field name="model">resellerclub.customer</field>
        <field name="arch" type="xml">
            <list string="ResellerClub Customers" decoration-warning="sync_status == 'pending'" decoration-danger="sync_status == 'error'">
                <field name="name"/>
                <field name="email"/>
                <field name="resellerclub_customer_id"/>
                <field name="rc_status" widget="badge"
                       decoration-success="rc_status == 'active'"
                       decoration-danger="rc_status in ['suspended', 'deleted']"
                       decoration-warning="rc_status == 'inactive'"/>
                <field name="domain_count"/>
                <field name="hosting_count"/>
                <field name="ssl_count"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'synced'"
                       decoration-warning="sync_status == 'pending'"
                       decoration-danger="sync_status == 'error'"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <!-- Customer Form View -->
    <record id="resellerclub_customer_view_form" model="ir.ui.view">
        <field name="name">resellerclub.customer.form</field>
        <field name="model">resellerclub.customer</field>
        <field name="arch" type="xml">
            <form string="ResellerClub Customer">
                <header>
                    <button name="action_create_in_resellerclub" type="object"
                            string="Create in ResellerClub" class="btn-primary"
                            invisible="resellerclub_customer_id"/>
                    <button name="action_sync_from_resellerclub" type="object"
                            string="Sync from ResellerClub" class="btn-secondary"
                            invisible="not resellerclub_customer_id"/>
                    <button name="action_open_resellerclub" type="object"
                            string="Open in ResellerClub" class="btn-link"
                            invisible="not resellerclub_customer_id"/>
                    <field name="rc_status" widget="statusbar" statusbar_visible="active,suspended,inactive"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_domains" type="object" class="oe_stat_button" icon="fa-globe">
                            <field name="domain_count" widget="statinfo" string="Domains"/>
                        </button>
                        <button name="action_view_hosting" type="object" class="oe_stat_button" icon="fa-server">
                            <field name="hosting_count" widget="statinfo" string="Hosting"/>
                        </button>
                        <button name="action_view_ssl" type="object" class="oe_stat_button" icon="fa-lock">
                            <field name="ssl_count" widget="statinfo" string="SSL"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Not Synced" bg_color="text-bg-warning" invisible="resellerclub_customer_id"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Information">
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="company"/>
                        </group>
                        <group string="ResellerClub Details">
                            <field name="resellerclub_customer_id"/>
                            <field name="default_contact_id"/>
                            <field name="rc_selling_currency"/>
                            <field name="rc_total_receipts"/>
                            <field name="rc_language"/>
                        </group>
                    </group>
                    <group string="Synchronization" invisible="not resellerclub_customer_id">
                        <group>
                            <field name="sync_status" widget="badge"
                                   decoration-success="sync_status == 'synced'"
                                   decoration-warning="sync_status == 'pending'"
                                   decoration-danger="sync_status == 'error'"/>
                            <field name="last_sync_date"/>
                        </group>
                        <group>
                            <field name="sync_error_message" invisible="sync_status != 'error'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Domains" name="domains">
                            <field name="domain_ids" mode="list" readonly="1">
                                <list>
                                    <field name="domain_name"/>
                                    <field name="status" widget="badge"/>
                                    <field name="expiration_date"/>
                                    <field name="days_until_expiry"/>
                                </list>
                            </field>
                        </page>
                        <page string="Hosting" name="hosting">
                            <field name="hosting_ids" mode="list" readonly="1">
                                <list>
                                    <field name="domain_name"/>
                                    <field name="hosting_type"/>
                                    <field name="status" widget="badge"/>
                                    <field name="expiration_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="SSL Certificates" name="ssl">
                            <field name="ssl_ids" mode="list" readonly="1">
                                <list>
                                    <field name="domain_name"/>
                                    <field name="ssl_type"/>
                                    <field name="status" widget="badge"/>
                                    <field name="expiration_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Customer Search View -->
    <record id="resellerclub_customer_view_search" model="ir.ui.view">
        <field name="name">resellerclub.customer.search</field>
        <field name="model">resellerclub.customer</field>
        <field name="arch" type="xml">
            <search string="Search Customers">
                <field name="name"/>
                <field name="email"/>
                <field name="resellerclub_customer_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('rc_status', '=', 'active')]"/>
                <filter name="filter_suspended" string="Suspended" domain="[('rc_status', '=', 'suspended')]"/>
                <filter name="filter_not_synced" string="Not Synced" domain="[('resellerclub_customer_id', '=', False)]"/>
                <filter name="filter_sync_error" string="Sync Errors" domain="[('sync_status', '=', 'error')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'rc_status'}"/>
                    <filter name="group_sync" string="Sync Status" context="{'group_by': 'sync_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Customer Action -->
    <record id="action_resellerclub_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">resellerclub.customer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="resellerclub_customer_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first ResellerClub customer
            </p>
            <p>
                Link your Odoo contacts with ResellerClub customers to manage domains, hosting, and SSL certificates.
            </p>
        </field>
    </record>
</odoo>
