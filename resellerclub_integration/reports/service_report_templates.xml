<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Domain Report -->
    <record id="action_report_domain" model="ir.actions.report">
        <field name="name">Domain Report</field>
        <field name="model">resellerclub.domain</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">resellerclub_integration.report_domain</field>
        <field name="report_file">resellerclub_integration.report_domain</field>
        <field name="binding_model_id" ref="model_resellerclub_domain"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_domain">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Domain Registration Certificate</h2>

                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Domain Name:</strong>
                                <h3 t-field="o.domain_name"/>
                            </div>
                            <div class="col-6 text-end">
                                <span t-attf-class="badge #{o.status == 'active' and 'text-bg-success' or 'text-bg-warning'}"
                                      style="font-size: 1rem; padding: 0.5rem 1rem;">
                                    <t t-esc="o.status"/>
                                </span>
                            </div>
                        </div>

                        <table class="table table-bordered mt-4">
                            <tr>
                                <td width="30%"><strong>Registrant</strong></td>
                                <td t-field="o.partner_id.name"/>
                            </tr>
                            <tr>
                                <td><strong>Registration Date</strong></td>
                                <td t-field="o.registration_date"/>
                            </tr>
                            <tr>
                                <td><strong>Expiration Date</strong></td>
                                <td t-field="o.expiration_date"/>
                            </tr>
                            <tr>
                                <td><strong>Order ID</strong></td>
                                <td t-field="o.resellerclub_order_id"/>
                            </tr>
                        </table>

                        <h4 class="mt-4">Nameservers</h4>
                        <ul>
                            <li t-if="o.ns1" t-esc="o.ns1"/>
                            <li t-if="o.ns2" t-esc="o.ns2"/>
                            <li t-if="o.ns3" t-esc="o.ns3"/>
                            <li t-if="o.ns4" t-esc="o.ns4"/>
                        </ul>

                        <h4 class="mt-4">Protection Settings</h4>
                        <table class="table table-sm">
                            <tr>
                                <td>Privacy Protection</td>
                                <td>
                                    <t t-if="o.privacy_protection">Enabled</t>
                                    <t t-else="">Disabled</t>
                                </td>
                            </tr>
                            <tr>
                                <td>Theft Protection</td>
                                <td>
                                    <t t-if="o.theft_protection">Enabled (Locked)</t>
                                    <t t-else="">Disabled (Unlocked)</t>
                                </td>
                            </tr>
                            <tr>
                                <td>Auto Renew</td>
                                <td>
                                    <t t-if="o.auto_renew">Enabled</t>
                                    <t t-else="">Disabled</t>
                                </td>
                            </tr>
                        </table>

                        <div class="mt-5 text-center text-muted">
                            <small>
                                Generated on <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M')"/>
                            </small>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Services Summary Report -->
    <record id="action_report_services_summary" model="ir.actions.report">
        <field name="name">Services Summary</field>
        <field name="model">resellerclub.customer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">resellerclub_integration.report_services_summary</field>
        <field name="report_file">resellerclub_integration.report_services_summary</field>
        <field name="binding_model_id" ref="model_resellerclub_customer"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_services_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Services Summary</h2>

                        <div class="row mt-4">
                            <div class="col-12">
                                <strong>Customer:</strong>
                                <h3 t-field="o.partner_id.name"/>
                                <p t-field="o.partner_id.email"/>
                            </div>
                        </div>

                        <!-- Domains Section -->
                        <h4 class="mt-4">Domains (<t t-esc="len(o.domain_ids)"/>)</h4>
                        <t t-if="o.domain_ids">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Domain</th>
                                        <th>Status</th>
                                        <th>Expiration</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.domain_ids" t-as="domain">
                                        <tr>
                                            <td t-field="domain.domain_name"/>
                                            <td t-field="domain.status"/>
                                            <td t-field="domain.expiration_date"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No domains registered.</p>
                        </t>

                        <!-- Hosting Section -->
                        <h4 class="mt-4">Hosting Services (<t t-esc="len(o.hosting_ids)"/>)</h4>
                        <t t-if="o.hosting_ids">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Domain</th>
                                        <th>Type</th>
                                        <th>Plan</th>
                                        <th>Expiration</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.hosting_ids" t-as="hosting">
                                        <tr>
                                            <td t-field="hosting.domain_name"/>
                                            <td t-field="hosting.hosting_type"/>
                                            <td t-field="hosting.plan_name"/>
                                            <td t-field="hosting.expiration_date"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No hosting services.</p>
                        </t>

                        <!-- SSL Section -->
                        <h4 class="mt-4">SSL Certificates (<t t-esc="len(o.ssl_ids)"/>)</h4>
                        <t t-if="o.ssl_ids">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Domain</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Expiration</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.ssl_ids" t-as="ssl">
                                        <tr>
                                            <td t-field="ssl.domain_name"/>
                                            <td t-field="ssl.ssl_type"/>
                                            <td t-field="ssl.status"/>
                                            <td t-field="ssl.expiration_date"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No SSL certificates.</p>
                        </t>

                        <div class="mt-5 text-center text-muted">
                            <small>
                                Generated on <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M')"/>
                            </small>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
